{
  "name": "mindy-fe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "biome check . && node scripts/check-boundaries.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --workers=1",
    "hooks:install": "simple-git-hooks",
    "check": "pnpm lint && pnpm type-check && pnpm test && pnpm build"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged && node scripts/check-boundaries.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css}": "biome check --write"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "5.9.1",
    "geist": "^1.7.2",
    "gsap": "^3.15.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lint-staged": "16.2.7",
    "simple-git-hooks": "2.14.0",
    "typescript": "5.9.3",
    "vitest": "4.0.2"
  }
}
