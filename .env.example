# NestJS API, accessed only by the Next.js server. Never use NEXT_PUBLIC_ here.
API_BASE_URL=https://api.quanh123.id.vn/api/v1
# Browser origin. Must match the URL used to open the frontend (no trailing slash).
APP_ORIGIN=http://localhost:3002

# Separate local JavaScript Docker runner from ../test (base origin, no /api/v1).
COMPILER_API_URL=http://127.0.0.1:4000

# Google is configured on NestJS, not in NEXT_PUBLIC_ variables.
# Match FRONTEND_BASE_URL to APP_ORIGIN and GOOGLE_REGISTRATION_PATH=/register/complete.
# GOOGLE_REDIRECT_URI must use this frontend origin + /api/v1/auth/google/callback.
# See docs/implement_phase/prompt-1-2-report.md for the complete origin/cookie checklist.
